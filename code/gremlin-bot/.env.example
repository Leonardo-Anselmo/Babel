# Gremlin settings. Copy this file to ".env" (no .example) and fill in the keys.
# Never share .env or post it anywhere: it holds your passwords to these services.

# ---- Required keys -----------------------------------------------------------

# Discord Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=

# console.anthropic.com > Settings > API keys (this is separate from a Claude.ai subscription)
ANTHROPIC_API_KEY=

# console.deepgram.com > API Keys (new accounts get $200 of free credit)
DEEPGRAM_API_KEY=

# elevenlabs.io > Developers > API Keys
ELEVENLABS_API_KEY=

# Optional, for pictures: aistudio.google.com/apikey > Create API key, then turn on billing
# for its Google project (pictures aren't on the free tier). See IMAGES below.
GEMINI_API_KEY=

# Optional, for anything Venice does: writing some of his lines (see VENICE_FOR below) and
# enables that retry, even with VENICE_FOR off. venice.ai/settings/api > Generate Key, type
# Inference Only. The account needs credit.
VENICE_API_KEY=
# Run "npm run voices" to list voices you can use, then paste one voice_id here
ELEVENLABS_VOICE_ID=

# ---- Personality and behavior --------------------------------------------------

# The name it answers to in voice. Keep it the same as the bot's name in Discord.
BOT_NAME=Gremlin
# Other spellings speech recognition might produce, comma separated
BOT_ALIASES=gremlins,grem,gremmy

# How often it jumps in without being called: off, low, medium, high
# (anyone can change it live with /chattiness). low = every few minutes at most.
CHATTINESS=low

# Used for "what time is it" style awareness
BOT_TIMEZONE=America/Los_Angeles

# Let it see what game everyone is playing (needs "Presence Intent" turned on
# in the Developer Portal > Bot page). Gives it more to talk about.
ENABLE_PRESENCE=false

# Leave voice after everyone else has left for this many seconds
AUTO_LEAVE_SECONDS=60

# Join a voice channel by itself when two or more people are hanging out in it
# (and follow them if they all move). /leave sends it away until everyone has left
# voice. Anyone can switch it per server with /autojoin on or off; the desktop app
# has a switch on Home.
AUTO_JOIN=false

# Reminders and timers: "Babel, remind me in ten minutes to queue" or "set a timer
# for five minutes". Said in the call when they go off (posted in the text chat if
# it isn't in a call then). Up to a day ahead; kept in data/memory.json.
REMINDERS=true

# Shared lists for the whole server, kept between calls: "Babel, add Hades 2 to the
# games list", "take Deadlock off it", "post the shopping list" (or the same by
# @mentioning it in text). It posts a list in the text chat when asked. Up to 20
# lists of 50 items each; kept in data/memory.json.
LISTS=true

# The desktop app restarts it by itself to load an update (new code, a changed
# setting or personality file) once nobody is in a call with it.
AUTO_UPDATE=true

# Remember calls: keeps short notes on each call (at most 10 per server, in
# data/memory.json) and reads them at the start of the next one, so it can bring
# things up later. /join tells everyone it's on. Read or delete them in the desktop
# app under Personality > Call memory.
CALL_MEMORY=false

# The bot's owner (whoever owns the Discord app) can say "<name>, look at this"
# and it sees a picture of this PC's main screen with that question. Nobody else
# can. Works only when the bot is started from the desktop app.
SCREEN_LOOKS=true

# Learn how its jokes land in each server: a laugh after one of its own jokes makes
# it joke a bit more often there; "shut up" or being talked over makes it wait
# longer and be pickier. Kept in data/memory.json.
JOKE_TUNING=true

# Keep its last dozen jokes that got a laugh (data/memory.json) and let it call back
# to one in a later call when something sets it up. /forgetcalls clears them.
JOKE_CALLBACKS=true
# A quick "Hmm." or "Ooh." now and then when a question takes him a moment
THINKING_SOUNDS=true
# Laughing along sometimes when the group cracks up (never at his own lines)
LAUGH_ALONG=true
# A quick hi when someone joins his call, and bye when someone says they're heading out
HELLO_GOODBYE=true
# Songs on request ("make a song about..."), made with ElevenLabs Music and played in
# the call. The ElevenLabs key needs access to Music. About $0.15 a minute of song;
# SONG_MINUTES_PER_MONTH caps it (your plan's own allowance may be lower).
SONGS=true
SONG_MINUTES_PER_MONTH=10
SONG_MAX_SECONDS=60
# SONG_MODEL=music_v2_5
# Pictures on request ("draw us a goblin playing League"), drawn by Google Gemini and posted
# in the text chat. Needs GEMINI_API_KEY and the Attach Files permission for the bot's role.
# About $0.034 a picture; IMAGES_PER_MONTH caps it.
IMAGES=true
IMAGES_PER_MONTH=100
# IMAGE_MODEL=gemini-nano-banana-2.1

# ---- Brain (Claude) ------------------------------------------------------------

# Answers when someone talks to it by name, roasts, and text-chat replies.
# claude-sonnet-5-5 = funnier; claude-haiku-5-5 = faster and about 20x cheaper
CLAUDE_MODEL=claude-sonnet-5-5
# Used for quick back-and-forth (replies without its name) and notes on calls
CLAUDE_FAST_MODEL=claude-haiku-5-5
# Writes its own jokes in a pause. Sonnet's are much funnier (about half a cent a
# try); Haiku is cheaper but almost never jumps in.
CLAUDE_JOKE_MODEL=claude-sonnet-5-5
# How hard each model works on a reply: low, medium or high. Higher means more
# careful answers and more willingness to look things up, but a little slower.
CLAUDE_EFFORT=high
CLAUDE_FAST_EFFORT=medium
# Only needed if your Anthropic key isn't tied to a workspace (the API will say so)
ANTHROPIC_WORKSPACE_ID=
# Safety valve on spending: max unprompted "anything funny?" checks per minute.
# Replies people actually ask for get 3x this much headroom.
CLAUDE_MAX_CALLS_PER_MINUTE=20

# Web search: when someone asks it something current (patch notes, metas,
# release dates, news), it looks it up first and posts the source links in the
# text channel. Roughly 2 to 5 cents per search, and it only searches when a
# question needs it. true or false.
WEB_SEARCH=true
# Most searches for one answer (2 lets it try again if the first one comes up
# short), and per day (a safety cap on what searches cost).
WEB_SEARCH_MAX_USES=2
WEB_SEARCH_DAILY_LIMIT=100

# Venice's models can write some of its lines instead of Claude:
# off, jokes (its own jokes and roasts), answers (also its answers, hellos and
# byes; answers can't look things up) or all (also its replies without its name;
# Claude decides with a quick yes or no whether those get a reply, since Venice
# replies to almost everything). Needs VENICE_API_KEY and credit on the account.
# Leave routing off to use Claude for all replies.
VENICE_FOR=off
VENICE_MODEL=qwen-3-8-27b
VENICE_TEMPERATURE=0.7

# ---- Voice (ElevenLabs) --------------------------------------------------------

# eleven_flash_v2_5 is the fastest and cheapest. eleven_v4_turbo is about as fast,
# more expressive (it performs tags like [laughs]) and costs the same; eleven_v4 is
# richer and costs twice as much. If the model can't be used (not on your account),
# it switches to eleven_flash_v2_5 for the rest of the run and says so in the log.
ELEVENLABS_MODEL=eleven_flash_v2_5
# Raw audio format. pcm_24000 works on every plan; pcm_44100 needs the Pro plan.
ELEVENLABS_OUTPUT_FORMAT=pcm_24000
# Lower stability = more expressive and unpredictable (0 to 1)
ELEVENLABS_STABILITY=0.4
ELEVENLABS_SIMILARITY=0.75
ELEVENLABS_STYLE=0
# 0.7 to 1.2
ELEVENLABS_SPEED=1.0
# Let it add delivery tags like [laughs] or [whispers]: for eleven_v4_turbo and
# eleven_v4 (other models get the words without the tags)
ELEVENLABS_AUDIO_TAGS=false
# Playback volume multiplier
BOT_VOLUME=1.0

# ---- Hearing (speech-to-text) ---------------------------------------------------

# whisper = free, on your NVIDIA graphics card (run setup-whisper.bat once first);
#   Deepgram covers automatically whenever Whisper isn't running, if you have a key
# deepgram = Deepgram's servers (default)
# elevenlabs = uses your ElevenLabs key, no Deepgram account needed
STT_PROVIDER=deepgram
STT_LANGUAGE=en
# Boost recognition of the bot's name and people's names (small extra cost on Deepgram)
STT_KEYTERMS=true
# Whisper model: large-v3 (most accurate, about 4.5 GB of graphics memory),
# large-v3-turbo (nearly as accurate, about 2.5 GB, over twice as fast) or
# distil-large-v3.5 (English only). Changing it means running setup-whisper.bat again.
WHISPER_MODEL=large-v3
# Extra words it should recognize: game names, nicknames, comma separated
STT_EXTRA_TERMS=Zomboid
# Learn words from your games it mishears: when it answers with a word spelled
# differently from what it heard ("Malenia" for "melania"), twice, the word becomes a
# hint for the speech-to-text (Whisper on longer sentences, Deepgram as a keyterm).
LEARN_WORDS=true

# How long a pause ends someone's sentence (milliseconds). Raise it if it cuts people off.
SILENCE_MS=700
# Ignore sounds shorter than this (coughs, clicks)
MIN_SPEECH_MS=300
# Loudness that counts as speech. Lower it if quiet friends get ignored.
VOICE_RMS_THRESHOLD=200
# Speech must also be this many times louder than each person's background noise,
# so an open mic's hiss or keyboard doesn't count as talking. Lower it (or 0 for off)
# if a quiet friend in a noisy room gets ignored.
NOISE_MARGIN=2

# With Whisper: after a short pause, a small model on the processor judges from
# the sound whether they're done talking, so it answers without waiting the full
# SILENCE_MS. Turn it off if it cuts people off.
SMART_TURN=true
# Pause when the person it's answering talks over it (it carries on after a laugh
# or "yeah", and answers anything else)
TALK_OVER_PAUSE=true
# With Whisper and a name detector for its name (whisper/extras/<name>.onnx): how
# sure the detector must be (0.3 to 0.99) that its name was said. Raise it if it
# reacts to words that only sound like its name.
NAME_DETECTOR_THRESHOLD=0.7

# ---- Troubleshooting -------------------------------------------------------------

# debug shows timing for every step
LOG_LEVEL=info
# true prints what it hears into the log. Handy for testing, keep false otherwise.
LOG_TRANSCRIPTS=false
# true prints low-level voice connection details
DEBUG_VOICE=false
